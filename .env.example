# Copy to .env.local for local development. Never commit real values.

# Postgres. Locally any Postgres works; on Vercel the Neon integration sets it.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/warbag_dev

# Long random string. Signs session cookies. Changing it signs everyone out.
BETTER_AUTH_SECRET=

# The site's public URL. Optional locally.
BETTER_AUTH_URL=http://localhost:3000

# The owner's sign-in email. Created as the first admin on each migrate.
OWNER_EMAIL=

# Email. Without these, local dev prints sign-in codes to the server console.
RESEND_API_KEY=
EMAIL_FROM=
